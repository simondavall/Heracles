{
  "ConnectionStrings": {
    "HeraclesDb": "Server=(localdb)\\mssqllocaldb;Database=HeraclesDb;Trusted_Connection=True;MultipleActiveResultSets=true",
    "HeraclesAuthDb": "Server=(localdb)\\mssqllocaldb;Database=HeraclesAuthDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
