@if (_isLoading)
{
    <div class="activity-navigation-state">
        <MudProgressCircular Indeterminate="true"
                             Size="Size.Small"
                             Color="Color.Primary" />

        <MudText Typo="Typo.body2">
            Loading activities...
        </MudText>
    </div>
}
else if (_currentActivity is null || _years.Count == 0)
{
    <div class="activity-navigation-state">
        <MudText Typo="Typo.body2">
            No Activities
        </MudText>
    </div>
}
else
{
    <nav class="activity-navigation" aria-label="Activity navigation">
        @foreach (var year in _years)
        {
            var yearExpanded = _expandedYear == year.ActivityYear;

            <div class="activity-year">
                <button type="button"
                        class="activity-navigation-heading activity-year-heading"
                        aria-expanded="@yearExpanded"
                        @onclick="() => ToggleYearAsync(year.ActivityYear)">
                    <span class="activity-navigation-title">
                        @year.ActivityYear
                    </span>

                    <span class="activity-navigation-count">
                        @year.Count
                    </span>

                    <MudIcon Icon="@(yearExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                             Class="activity-navigation-chevron" />
                </button>

                @if (yearExpanded)
                {
                    <div class="activity-months">
                        @foreach (var month in GetMonths(year.ActivityYear))
                        {
                            var monthExpanded = _expandedMonth == month.ActivityYearMonth;

                            <div class="activity-month">
                                <button type="button"
                                        class="activity-navigation-heading activity-month-heading"
                                        aria-expanded="@monthExpanded"
                                        @onclick="() => ToggleMonthAsync(month)">
                                    <span class="activity-navigation-title">
                                        @GetMonthName(month.ActivityYearMonth)
                                    </span>

                                    <span class="activity-navigation-count">
                                        @month.Count
                                    </span>

                                    <MudIcon Icon="@(monthExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                             Class="activity-navigation-chevron" />
                                </button>

                                @if (monthExpanded)
                                {
                                    <div class="activity-list">
                                        @if (_isLoadingMonth)
                                        {
                                            <div class="activity-month-state">
                                                <MudProgressCircular Indeterminate="true"
                                                                     Size="Size.Small"
                                                                     Color="Color.Primary" />
                                            </div>
                                        }
                                        else if (_activities.Count == 0)
                                        {
                                            <div class="activity-month-state">
                                                No Activities
                                            </div>
                                        }
                                        else
                                        {
                                            @foreach (var activity in _activities)
                                            {
                                                var selected = activity.ActivityId == _selectedActivityId;

                                                <button type="button"
                                                        class="@GetActivityClass(selected)"
                                                        aria-current="@(selected ? "page" : null)"
                                                        @onclick="() => SelectActivity(activity.ActivityId)">
                                                    <span class="activity-date">
                                                        <span class="activity-month-name">
                                                            @activity.Month
                                                        </span>

                                                        <span class="activity-day">
                                                            @activity.DayOfMonth
                                                        </span>
                                                    </span>

                                                    <span class="activity-summary">
                                                        <span class="activity-title">
                                                            @activity.MainText
                                                        </span>

                                                        <span class="activity-distance">
                                                            @activity.Distance @activity.DistanceUnits
                                                        </span>
                                                    </span>

                                                    <MudIcon Icon="@Icons.Material.Filled.ChevronRight"
                                                             Class="activity-chevron" />
                                                </button>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </nav>
}