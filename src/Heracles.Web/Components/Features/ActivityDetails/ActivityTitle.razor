<div class="activity-title">
    <img class="activity-title-image"
         src="@ImagePath"
         alt="" />

    <div class="activity-title-content">
        <MudText Typo="Typo.h6"
                 Class="activity-title-heading">
            @Title
        </MudText>

        <MudText Typo="Typo.caption"
                 Color="Color.Secondary"
                 Class="activity-title-date">
            @Date
        </MudText>
    </div>
</div>