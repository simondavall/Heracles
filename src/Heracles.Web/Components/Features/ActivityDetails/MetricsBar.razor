@using Heracles.Web.Components.Features.ActivityDetails.Splits
<div class="metrics-bar">
    <ActivityMetric Title="km"
                    ImagePath="/images/metrics/distance.png"
                    Value="@Distance" />

    <ActivityMetric Title="Duration"
                    ImagePath="/images/metrics/duration.png"
                    Value="@Duration" />

    <ActivityMetric Title="Average Pace"
                    ImagePath="/images/metrics/pace_speed.png"
                    Value="@Pace"
                    Clicked="ShowSplits" />

    <ActivityMetric Title="Rank"
                    ImagePath="/images/metrics/rank.png"
                    Value="@Rank"
                    SecondaryValue="@RankCount" />
</div>

@if (_showSplits)
{
    <ActivitySplits Track="@Track"
                    Closed="CloseSplits" />
}