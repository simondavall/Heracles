<div class="container">
    <div class="row statsBar">
        <div id="totalDistance" class="col-3 statsItem">
            <h5>@DistanceTitle</h5>
            <h1><span class="value">@DistanceValue</span>
            </h1>
        </div>
        <div id="totalDuration" class="col-3 statsItem">
            <h5>@DurationTitle</h5>
            <h1><span class="value">@DurationValue</span></h1>
        </div>
        <div id="averagePace" class="col-3 statsItem">
            <h5>@PaceTitle</h5>
            <h1><span class="value">@PaceValue</span>
            </h1>
        </div>
        <div id="rank" class="col-3 statsItem">
            <h5>@RankTitle</h5>
            <h1><span class="value">@RankValue/@RankCount</span>
            </h1>
        </div>
    </div>
</div>