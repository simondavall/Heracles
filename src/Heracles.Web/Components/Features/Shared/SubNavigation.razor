@using Microsoft.AspNetCore.Components.Authorization

<div class="userNavContainer clearfix">
    <a href="/import">
        <div class="userNavItem import @GetTabClass(SubNavTab.Import)">
            <p>IMPORT</p>
        </div>
    </a>
    <div class="userNavBorder left "></div>
    <div class="userNavBorder right @GetTabClass(SubNavTab.Reports)"></div>
    <a href="#">
        <div class="userNavItem reports @GetTabClass(SubNavTab.Reports)">
            <p>REPORTS</p>
        </div>
    </a>
    <div class="userNavBorder left "></div>
    <div class="userNavBorder right @GetTabClass(SubNavTab.Dashboard)"></div>
    <a href="/">
        <div class="userNavItem dashboard @GetTabClass(SubNavTab.Dashboard)">
            <p>DASHBOARD</p>
        </div>
    </a>

    <AuthorizeView>
        <Authorized>
            <div class="userNavBorder left selected"></div>
            <div class="userNavItem" id="userProfile">
                <div id="imgContainer" class="profileBoxSmall">
                    <div class="avatarContainer">
                        <a class="avatar" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">
                            <img src="/images/profile-med.jpg" title="@DisplayName(context.User)" alt=""/>
                        </a>
                    </div>
                </div>
                <div id="userNameContainer">
                    <div id="userNameText">
                        <p class="userName">@DisplayName(context.User)</p>
                        <p class="activeSince">@ActiveSince</p>
                    </div>
                </div>
            </div>
        </Authorized>
    </AuthorizeView>
</div>
