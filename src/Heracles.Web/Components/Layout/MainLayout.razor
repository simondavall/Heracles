@inherits LayoutComponentBase
@using Heracles.Web.Components.Theme
@using Microsoft.AspNetCore.Components.Authorization

<MudThemeProvider @ref="_themeProvider"
                  Theme="HeraclesTheme.Default"
                  IsDarkMode="_isDarkMode"/>

<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<MudLayout>
    <div class="application-header">
    <MudAppBar Elevation="0"
               Fixed="true">
        <div class="header-content">
            <MudText Typo="Typo.h6"
                     Color="Color.Inherit"
                     Class="application-title">
                Heracles
            </MudText>

            <MudSpacer/>

            <AuthorizeView>
                <Authorized Context="auth">
                    <MudButton Href="/account"
                               Variant="Variant.Text"
                               Color="Color.Inherit"
                               StartIcon="@Icons.Material.Filled.AccountCircle"
                               Class="user-button">
                        @DisplayName(auth.User)
                    </MudButton>

                    <MudIconButton Icon="@ThemeToggleIcon"
                                   Color="Color.Inherit"
                                   OnClick="ToggleThemeAsync"
                                   Title="@ThemeToggleText"
                                   aria-label="@ThemeToggleText"/>

                    <MudIconButton Icon="@Icons.Material.Filled.Logout"
                                   Color="Color.Inherit"
                                   Href="/authentication/logout"
                                   Title="Logout"
                                   aria-label="Logout"/>
                </Authorized>
            </AuthorizeView>
        </div>
    </MudAppBar>
    </div>
    <MudMainContent Class="application-main">
        <div class="application-body">
            <div class="primary-navigation">
                @* Primary navigation component will be added by the next task. *@
            </div>

            <main class="main-content">
                @Body
            </main>
        </div>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>