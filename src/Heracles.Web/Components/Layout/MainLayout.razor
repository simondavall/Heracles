@inherits LayoutComponentBase
@using Heracles.Web.Components.Theme

<MudThemeProvider @ref="_themeProvider"
                  Theme="HeraclesTheme.Default"
                  IsDarkMode="_isDarkMode" />

<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <div class="application-header">
        <MudAppBar Elevation="0"
                   Fixed="true">
            <div class="header-content">
                <MudText Typo="Typo.h6"
                         Color="Color.Inherit">
                    Heracles
                </MudText>

                <MudSpacer />

                <AuthorizeView>
                    <Authorized Context="auth">
                        <MudButton Href="https://soteria.local/account/manage"
                                   Target="_blank"
                                   Variant="Variant.Text"
                                   Color="Color.Inherit"
                                   StartIcon="@Icons.Material.Filled.AccountCircle">
                            @DisplayName(auth.User)
                        </MudButton>

                        <MudIconButton Icon="@ThemeToggleIcon"
                                       Color="Color.Inherit"
                                       OnClick="ToggleThemeAsync"
                                       Title="@ThemeToggleText"
                                       aria-label="@ThemeToggleText" />

                        <MudIconButton Icon="@Icons.Material.Filled.Logout"
                                       Color="Color.Inherit"
                                       Href="/authentication/logout"
                                       Title="Logout"
                                       aria-label="Logout" />
                    </Authorized>
                </AuthorizeView>
            </div>
        </MudAppBar>
    </div>

    <div class="application-main">
        <MudMainContent>
            <div class="application-body">
                <PrimaryNavigation />

                <main class="main-content">
                    @Body
                </main>
            </div>
        </MudMainContent>
    </div>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>