@inherits LayoutComponentBase

@using Heracles.Web.Components.Theme
@using Microsoft.AspNetCore.Components.Authorization

<MudThemeProvider @ref="_themeProvider"
                  Theme="@HeraclesTheme.Default"
                  IsDarkMode="@_isDarkMode" />

<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />


<MudLayout>
    <MudAppBar Elevation="1">
        <MudText Typo="Typo.h6">Heracles</MudText>

        <MudSpacer />

        <MudTooltip Text="@ThemeToggleText">
            <MudIconButton Icon="@ThemeToggleIcon"
                           Color="Color.Inherit"
                           OnClick="ToggleThemeAsync"
                           aria-label="@ThemeToggleText" />
        </MudTooltip>

        <AuthorizeView>
            <Authorized>
                <MudButton Href="https://soteria.local/Account/Manage"
                           Target="_blank"
                           rel="noopener noreferrer"
                           Variant="Variant.Text"
                           Color="Color.Secondary">
                    @DisplayName(context.User)
                </MudButton>

                <MudButton Color="Color.Inherit"
                           Variant="Variant.Text"
                           Href="/authentication/logout">
                    Log Out
                </MudButton>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>
