@inherits LayoutComponentBase

@using Heracles.Web.Components.Theme

<MudThemeProvider @ref="_themeProvider"
                  Theme="@HeraclesTheme.Default"
                  IsDarkMode="@_isDarkMode" />

<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudText Typo="Typo.h6">Heracles</MudText>

        <MudSpacer />

        <MudSelect T="ThemeMode"
                   Value="@_themeMode"
                   ValueChanged="SetThemeModeAsync"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Style="width: 130px">
            <MudSelectItem Value="@ThemeMode.System">System</MudSelectItem>
            <MudSelectItem Value="@ThemeMode.Light">Light</MudSelectItem>
            <MudSelectItem Value="@ThemeMode.Dark">Dark</MudSelectItem>
        </MudSelect>
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>